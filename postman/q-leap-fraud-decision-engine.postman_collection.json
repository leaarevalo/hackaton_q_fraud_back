  "item": [
    {
      "name": "Healthcheck",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('service is healthy', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Evaluate - Regular Transfer GREEN",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenantId\": \"{{tenantId}}\",\n  \"scope\": \"POINTS_TRANSFER\",\n  \"transaction\": {\n    \"id\": \"tx_regular_{{$timestamp}}\",\n    \"timestamp\": \"2026-07-24T13:10:00Z\",\n    \"points\": 500,\n    \"currency\": \"LOYALTY_PTS\"\n  },\n  \"sender\": {\n    \"userId\": \"usr_sender_old\",\n    \"accountCreatedAt\": \"2025-01-01T10:00:00Z\",\n    \"ip\": \"200.45.12.5\"\n  },\n  \"receiver\": {\n    \"userId\": \"usr_friend_999\",\n    \"ip\": \"200.45.99.10\"\n  },\n  \"device\": {\n    \"fingerprint\": \"fp_trusted_001\",\n    \"associatedAccountsCount\": 1,\n    \"isNewForUser\": false,\n    \"platform\": \"iOS\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/fraud/evaluate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "fraud",
            "evaluate"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('decision is GREEN', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.decision.riskLevel).to.eql('GREEN');",
              "  pm.expect(body.decision.recommendedAction).to.eql('APPROVE');",
              "});"
            ]
          }
        }
      ]
    },
